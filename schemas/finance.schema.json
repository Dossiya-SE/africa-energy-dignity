          },
          "evidence": {
            "evidence_class": "scenario",
            "validation_status": "schema_valid",
            "responsible_contributor": "Synthetic AED reviewer",
            "limitations": [
              "Synthetic amount used only for deterministic verification."
            ]
          }
        }
      ],
      "annual_energy": [
        {
          "year": 1,
          "energy": 200,
          "unit": "MWh",
          "evidence": {
